{
  "name": "an22-web",
  "version": "0.1.0",
  "private": true,
  "description": "Static server ของหน้าบ้าน An22 (Angular SPA) + proxy /api → api",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "dev": "node --env-file-if-exists=.env --watch src/server.ts | pino-pretty",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "docker:build": "sh scripts/docker-build.sh"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "connect-mongo": "^6.0.0",
    "cookie": "^2.0.1",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "http-proxy-middleware": "^4.2.0",
    "memorystore": "^1.6.8",
    "mongodb": "^7.7.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^24.19.2",
    "pino-pretty": "^13.2.0",
    "typescript": "^7.0.2"
  }
}
