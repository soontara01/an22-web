# คัดลอกเป็น .env สำหรับ dev (npm start อ่านให้เอง) — production ตั้งเป็น env var
PORT=4000
API_URL=http://localhost:8080
DIST_DIR=../FrontEnd-An22/dist/frontend-an22/browser
LOG_LEVEL=info

# session ของ login (E48 — cookie httpOnly, token อยู่ฝั่ง web)
# memory = เครื่องเดียว หลุดเมื่อ restart; mongodb = หลาย instance / อยู่รอด restart (docker compose up -d mongo)
SESSION_STORE=memory
# MONGODB_URI=mongodb://127.0.0.1:27017/an22
# บังคับ ≥ 32 ตัว — สร้าง: openssl rand -base64 48 (ค่าตัวอย่างนี้ห้ามใช้จริง)
SESSION_SECRET=dev-only-change-me-dev-only-change-me-0000
SESSION_IDLE_HOURS=12
SESSION_MAX_DAYS=7
# auto = Secure เมื่อมาทาง https (ตาม X-Forwarded-Proto ของ proxy ที่เชื่อใน TRUST_PROXY)
COOKIE_SECURE=auto
TRUST_PROXY=loopback
